# --- LLM ---
# Google Generative AI API Key — used for cheap triage (watch loop) and optional
# tailoring during drafting. Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_ai_api_key

# Cheap model id used for watch-loop triage (fit/timeliness/unique-value scoring).
# Defaults to gemini-3.5-flash; can also be set per-run in watch.yaml.
TRIAGE_MODEL=gemini-3.5-flash

# --- X (Twitter) credential login ---
# publish-cli does an UNATTENDED credential login with Playwright over a persistent
# browser profile — NO official API key and NO manually-pasted cookies. The session
# module logs in once, persists the profile, and harvests the auth_token + ct0
# cookies; both the watcher (cookie reads) and the publisher (browser automation)
# reuse that one logged-in session.
#   X_USERNAME: your X handle (without the leading @)
#   X_PASSWORD: your X password
#   X_EMAIL:    used to answer X's "confirm your phone/email" identifier challenge
# (No 2FA is supported — the only interruption handled is the email/identifier step.)
X_USERNAME=your_handle
X_PASSWORD=your_password
X_EMAIL=your_login_email

# --- LinkedIn credential login ---
# The LinkedIn channel (publish linkedin draft) uses the SAME model as X: an
# unattended credential login with Playwright over a persistent browser profile
# (no API key, no pasted cookies). The session module logs in once and persists
# the profile; only the publisher (composer) reuses that logged-in session today.
#   LI_USERNAME: your LinkedIn login (email or member handle)
#   LI_PASSWORD: your LinkedIn password
#   LI_EMAIL:    used to answer LinkedIn's email/identifier confirmation checkpoint
# (No 2FA/CAPTCHA is automated — those interrupt the flow; run with --inspect.)
LI_USERNAME=your_linkedin_login
LI_PASSWORD=your_password
LI_EMAIL=your_login_email

# --- Reddit credential login ---
# The Reddit channel (publish reddit inspect/search/draft) uses the SAME model as
# X and LinkedIn: an unattended credential login with Playwright over a persistent
# browser profile (no API key, no pasted cookies). The session module logs in once
# and persists the profile; the reader (subreddit facts) and the publisher
# (composer) reuse that logged-in session.
#   REDDIT_USERNAME: your Reddit username
#   REDDIT_PASSWORD: your Reddit password
#   REDDIT_EMAIL:    used to answer Reddit's email/identifier confirmation checkpoint
# (No 2FA/CAPTCHA is automated — those interrupt the flow; run with --inspect.)
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_password
REDDIT_EMAIL=your_login_email
# Optional. Set to 1 if `reddit inspect`/`reddit search` are 403-blocked headless on
# your network (Reddit's edge blocks headless Chrome's fingerprint). Reads are
# login-free, so a headful browser needs NO human — just a display to render into.
# Reads also AUTO-RETRY headful on a block; this just skips the doomed first attempt.
# Leave unset on headless servers / good-fingerprint hosts (headful needs a display).
# REDDIT_READS_HEADFUL=1

# --- Machine-local runtime dir (session/secret artifacts) ---
# Where the persistent browser profile + harvested cookie cache live. These are
# machine-local and MUST NOT sit on a cloud-synced path or inside the repo.
# Defaults to ${HOME}/.publish-cli when unset.
# PUBLISH_DATA_DIR=/Users/you/.publish-cli

# --- Data repo (DURABLE state: the dedupe DB + the agent-skill symlink target) ---
# The agent workspace. publish-cli writes its dedupe DB to <repo>/.publish-cli/ and
# symlinks the `publish` skill into <repo>/.agents/skills/. Resolution order:
# PUBLISH_DATA_REPO → publish.config.dev.yaml (data_repo_path) → walk up from cwd for
# .agents/workspace.yaml. Set this for ad-hoc runs outside the workspace.
# PUBLISH_DATA_REPO=/path/to/agent-workspace

# --- Behavior config ---
# Watch behavior (queries, accounts, triage criteria) lives in watch.yaml — not here.
