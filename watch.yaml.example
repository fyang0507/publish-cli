# publish-cli — X watch config (borrowed-reach / watch loop).
# Copy to watch.yaml and edit. CLI flags (--query, --x-list) ADD to these values
# at runtime. This file is schema-validated on load: unknown keys and wrong types
# fail loudly before the browser opens (no silent defaulting).

# Cheap model used to triage candidates. Overrides TRIAGE_MODEL env when set.
triage_model: gemini-3.5-flash

# Search queries to monitor. Each is run against X search; recent matching posts are
# pulled, deduped against the local seen-store, then triaged.
queries:
  - "agent harness reliability"
  - "LLM evals in production"
  - "context engineering"
  - "\"forward deployed engineer\" AI"

# X List ids to monitor — this is the account-watch path. One fetch of
# `x.com/i/lists/<id>` returns the merged recent timeline of ALL members, so a
# List of N accounts costs one page load instead of N (N per-account profile
# loads don't scale and read as bot traffic, so there is no `accounts:` origin).
# Build a List from the accounts you follow with `publish x create-watch-list`
# (it prints the id), or curate one in the X UI, then paste ids here (repeatable)
# or pass --x-list <id> on the CLI.
lists: []
#   - "1700000000000000000"

# How many recent posts to pull per origin (query / list) on each poll.
per_origin_limit: 25

# Max characters of a thread's text kept per candidate. A watched account's thread
# is collapsed into ONE candidate (reply target = the thread root, not a mid-thread
# tweet) and its tweets are concatenated; this caps how much of that lands in the
# triage classifier's context. Over the cap, the head and tail are kept and the
# middle is elided. Applies to --no-triage runs too (it governs candidate assembly).
max_thread_chars: 1500

# Triage criteria — passed to the cheap model as the rubric for scoring each post on
# whether it's worth a follow-up reply. Higher score = stronger follow-up candidate.
triage:
  # Free-text reply-worthiness rubric: WHO is replying and what unique value they
  # add, so the model can judge fit and whether a reply would be additive (not
  # noise). Ships BLANK in this public repo — the calling agent owns triage and
  # supplies this per run via --persona / --persona-from (issue #6). A blank
  # persona falls back to a generic default and prints a notice. Define your own
  # criteria in prose here; the scoring dimensions (fit / timeliness /
  # unique_value) are a fixed, DEFINED baseline in the prompt and are
  # intentionally not configurable by bare name.
  #
  # MUST BE SELF-CONTAINED. The classifier sees ONLY this rubric + the candidate
  # post — never the source essay, campaign brief, workspace files, or any other
  # agent context. A persona like "find replies for my agent-enablement essay" is
  # too implicit: it scores against a vague campaign name, not real editorial
  # judgment, so results look plausible but misaligned. Spell out the actual
  # selection criteria inline. Long rubrics are the right shape — keep them in a
  # file and pass `--persona-from ./rubric.md` rather than fighting shell quoting.
  persona: ""
  # Only surface candidates at or above this score (0-100) in the ranked output.
  min_score: 60
  # How many posts to send the cheap model per triage call. ~25 packs fine for
  # short tweets; much higher risks the low-effort model truncating its JSON
  # output. Config-only perf plumbing (tune with eval/, see eval/README.md).
  batch_size: 25
